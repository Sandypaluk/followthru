# Copy this file to .env and fill in real values. Never commit .env.

# From https://console.cloud.google.com/apis/credentials — OAuth 2.0 Client ID (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where the frontend runs, used for CORS and post-auth redirect
FRONTEND_URL=http://localhost:5173

PORT=3001
# DB_PATH=./followthru.db   # optional override, defaults next to package.json
